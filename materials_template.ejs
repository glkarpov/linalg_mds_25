```{=html}
<%
  var prevSection = null;
  for (const item of items) {
    if (item.section && item.section !== prevSection) {
      prevSection = item.section;
%>
    <h4 class="materials-section"><%= item.section %></h4>
<%
    }
%>
    <h3>Lecture <%= item.number %></h3>
    <p>
        <% 
            var links = [];
            if(item.slides_ru) { links.push('<a href="' + item.slides_ru + '">📄 Slides (RU)</a>'); }
            if(item.slides_en) { links.push('<a href="' + item.slides_en + '">📄 Slides (EN)</a>'); }
            if(item.notes) { links.push('<a href="' + item.notes + '">📝 Notes</a>'); }
            if(item.assignments) { links.push('<a href="' + item.assignments + '">📝 Assignments</a>'); }
            if(item.mind_map) { links.push('<a href="' + item.mind_map + '">🗺️ Mind Map</a>'); }
            if(item.youtube) { links.push('<a href="' + item.youtube + '">▶️ Youtube</a>'); }
            if(item.download) {
                if(Array.isArray(item.download)) {
                    for (const dl of item.download) {
                        if(dl.url) { links.push('<a href="' + dl.url + '">' + (dl.label || '💿 Download') + '</a>'); }
                    }
                } else {
                    links.push('<a href="' + item.download + '">💿 Download</a>');
                }
            }
            print(links.join(' • '));
        %>
    </p>
    <p><%= item.title %></p>
<% } %>
```
